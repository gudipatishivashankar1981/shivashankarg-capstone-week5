# Copy this file to .env for local use. Never commit real tokens.
# The application reads these from the process environment. Nothing loads
# .env automatically, so export the values in your shell before starting the
# API or the eval scripts (see the README quick start).

# --- API authentication (src/api/auth.py) ---
# Comma-separated name:token pairs. Required: without it every protected call
# returns 401 (fail closed). Generate long random tokens for real use.
EKA_API_TOKENS=dev:replace-with-a-long-random-token

# --- Eval client (scripts/run_rag_eval.py) ---
# Bearer token used with --endpoint. Must match one token in EKA_API_TOKENS.
EKA_API_TOKEN=replace-with-a-long-random-token

# --- Cost control (src/api/main.py) ---
# Per-caller daily budget in USD. Default: 25.
EKA_DAILY_BUDGET_USD=25

# --- Answer handler (src/api/main.py) ---
# placeholder (default, always escalates) or baseline (offline lexical demo).
EKA_HANDLER=placeholder

# --- Logging (src/api/main.py) ---
# Set to 1 to log question text. Development only: questions can contain
# personal data. Leave unset otherwise.
# EKA_LOG_QUESTIONS=1
